<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>ContextSmith</AssemblyName>
    <RootNamespace>ContextSmith</RootNamespace>
    <Product>右键菜单管理</Product>
    <Version>1.0.0</Version>

    <!-- 默认 asInvoker；写入 HKLM 时按需请求提权并续跑 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- ThemeMode (Fluent 主题) 在 .NET 9/10 中仍标记为实验性 API -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- dotnet publish -c Release 时生成单文件 exe（需目标机已安装 .NET 10 桌面运行时） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
