<Window x:Class="ContextSmith.Views.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建右键菜单项"
        Width="640" SizeToContent="Height" MaxHeight="840"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubText" Text="写入 HKEY_CURRENT_USER\SOFTWARE\Classes，仅对当前用户生效，可随时删除。"
                       Opacity="0.6" Margin="0,4,0,16" TextWrapping="Wrap" />

            <StackPanel x:Name="TemplatePanel">
                <TextBlock Text="从常用模板开始（可选）" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                <ComboBox x:Name="TemplateBox" DisplayMemberPath="Name" SelectionChanged="OnTemplateChanged" Margin="0,0,0,14" />
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="显示名称" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="注册表键名（建议英文）" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox x:Name="KeyBox" FontFamily="{StaticResource MonoFont}" TextChanged="OnKeyChanged" />
                </StackPanel>
            </Grid>

            <TextBlock Text="执行命令" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="OnBrowse" />
                <TextBox x:Name="CommandBox" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" MinHeight="56"
                         TextChanged="OnFieldChanged"
                         AcceptsReturn="False" VerticalContentAlignment="Top" />
            </DockPanel>
            <TextBlock x:Name="HintText" FontSize="11" Opacity="0.55" Margin="0,0,0,12" TextWrapping="Wrap" />

            <TextBlock Text="图标（可选，exe 路径或 dll,索引）" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="IconBox" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,14"
                     TextChanged="OnFieldChanged" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox x:Name="ExtendedBox" Content="仅在按住 Shift 时显示" Margin="0,0,0,8"
                              Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
                    <CheckBox x:Name="AdminBox" Content="以管理员身份运行（提权命令 + UAC 盾牌）"
                              Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="菜单位置" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <ComboBox x:Name="PositionBox" Width="110" SelectedIndex="0" SelectionChanged="OnFieldChanged">
                        <ComboBoxItem Content="默认" />
                        <ComboBoxItem Content="顶部" />
                        <ComboBoxItem Content="底部" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 写入预览：把即将发生的写入翻译成 .reg 文本，可复制或另存脚本 -->
            <TextBlock Text="写入内容预览（.reg — 另存后可双击导入）" FontSize="12" Opacity="0.7" Margin="0,14,0,4" />
            <TextBox x:Name="PreviewBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     TextWrapping="Wrap" Height="136" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                     BorderThickness="1" Padding="8,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="复制预览" Width="88" Margin="0,0,8,0" Click="OnCopyPreview" />
                <Button Content="另存为 .reg…" Width="110" Click="OnSaveScript" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" IsCancel="True" Width="88" Margin="0,0,8,0" />
                <Button Content="立即写入" IsDefault="True" Width="104" Style="{StaticResource AccentButton}" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
